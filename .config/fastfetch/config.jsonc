{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch",
    "type": "small",
    "padding": {
      "top": 2,
      "right": 4
    }
  },
  "display": {
    "separator": " 󰇙 ",
    "color": {
      "separator": "white"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "34",
        "at": "37",
        "host": "34"
      }
    },
    {
      "type": "custom",
      "format": "┌──────────────────────────────────────────────┐",
      "outputColor": "34"
    },
    {
      "type": "os",
      "key": "  󰣇 OS      ",
      "keyColor": "34"
    },
    {
      "type": "kernel",
      "key": "  󰒋 Kernel  ",
      "keyColor": "36"
    },
    {
      "type": "uptime",
      "key": "  󰅐 Uptime  ",
      "keyColor": "35"
    },
    {
      "type": "packages",
      "key": "  󰏖 Packages",
      "keyColor": "32"
    },
    {
      "type": "custom",
      "format": "├──────────────────────────────────────────────┤",
      "outputColor": "34"
    },
    {
      "type": "wm",
      "key": "  󱂬 WM      ",
      "keyColor": "35"
    },
    {
      "type": "shell",
      "key": "   Shell   ",
      "keyColor": "33"
    },
    {
      "type": "terminal",
      "key": "   Terminal",
      "keyColor": "32"
    },
    {
      "type": "custom",
      "format": "├──────────────────────────────────────────────┤",
      "outputColor": "34"
    },
    {
      "type": "cpu",
      "key": "  󰻠 CPU     ",
      "keyColor": "31",
      "format": "{1} ({4})",
      "temp": true
    },
    {
      "type": "gpu",
      "key": "  󰍛 GPU     ",
      "keyColor": "34",
      "format": "{2}",
      "temp": true
    },
    {
      "type": "memory",
      "key": "  󰑭 RAM     ",
      "keyColor": "36",
      "format": "{1} / {2} ({3})"
    },
    {
      "type": "disk",
      "key": "  󰋊 Disk    ",
      "keyColor": "33",
      "format": "{1} / {2} ({3})"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────────┘",
      "outputColor": "34"
    },
    "break",
    {
      "type": "custom",
      "format": "   󰮯  \u001b[31m󰊠  \u001b[32m󰊠  \u001b[33m󰊠  \u001b[34m󰊠  \u001b[35m󰊠  \u001b[36m󰊠  \u001b[37m󰊠 "
    },
    "break"
  ]
}